NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Optional: a dedicated Robinhood Chain RPC (chain id 4663). The public one is rate limited.
NEXT_PUBLIC_RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# ---- SERVER ONLY. Never prefix these with NEXT_PUBLIC_ and never commit them. ----
# Lets the server credit deposits and settle withdrawals (bypasses RLS).
SUPABASE_SERVICE_ROLE_KEY=

# BowPay treasury wallets. Users send funds here to fill their card; cash-outs are paid from here.
# Use dedicated wallets that hold only what the app needs. Solana: base58 secret key (or a JSON array).
BOWPAY_SOLANA_PRIVATE_KEY=
# Robinhood Chain: 0x + 64 hex chars. Keep a little ETH in it for gas, and a little SOL in the Solana one.
BOWPAY_RH_PRIVATE_KEY=

# Optional: lets you GET /api/treasury with header "x-admin-token" to see the treasury addresses AND live balances.
BOWPAY_ADMIN_TOKEN=

# Solana needs no RPC setting: lib/solana.ts rotates across public endpoints automatically.
